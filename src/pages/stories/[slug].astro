---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Share from '../../components/Share.astro';
import Ad from '../../components/Ad.astro';
import { SITE, AUTHOR, occBySlug, fmtDate } from '../../lib/site';
import { allStories, readMins } from '../../lib/stories';
export async function getStaticPaths() {
  const list = await allStories();
  return list.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, list } }));
}
const { entry, list } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const url = `${SITE.url}/stories/${d.slug}/`;
const mins = readMins(entry.body ?? '');
const occ = d.occasion ? occBySlug(d.occasion) : undefined;
const more = list.filter((s) => s.data.slug !== d.slug).slice(0, 3);
const jsonld = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', headline: d.title, description: d.description, mainEntityOfPage: url, genre: 'Children\'s short story',
    image: [new URL(`/og/stories-${d.slug}.png`, SITE.url).href], datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
    keywords: d.keywords, timeRequired: `PT${mins}M`, audience: { '@type': 'PeopleAudience', suggestedMinAge: parseInt(d.ages) || 3 },
    author: { '@type': 'Person', name: AUTHOR.name, url: `${SITE.url}/author/${AUTHOR.slug}/`, sameAs: [AUTHOR.linkedin] },
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png` } } },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Stories', item: `${SITE.url}/stories/` },
    { '@type': 'ListItem', position: 3, name: d.title, item: url } ] },
] };
---
<Base title={d.title} description={d.description} image={`/og/stories-${d.slug}.png`} imageAlt={d.imageAlt} type="article" publishedTime={d.date} modifiedTime={d.updated ?? d.date} keywords={d.keywords} jsonld={jsonld}>
  <article class="wrap story">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/stories/">Stories</a>{occ && <> › <a href={`/holiday/${occ.slug}/`}>{occ.name}</a></>}</nav>
    <h1 class="story-title">{d.title}</h1>
    <div class="pr-meta">
      <p class="byline">By <a href={`/author/${AUTHOR.slug}/`}>{d.author}</a> · Updated <time datetime={(d.updated ?? d.date).toISOString()}>{fmtDate(d.updated ?? d.date)}</time></p>
      <Share slug={`stories/${d.slug}`} title={d.title} image={`/pins/stories-${d.slug}.png`} />
    </div>
    <div class="story-facts"><span class="pill">{d.theme}</span><span class="pill">{d.level}</span><span class="pill">Ages {d.ages}</span><span class="pill">{mins} min read</span></div>
    {d.retoldFrom && <p class="retold">A retelling in our own words of a traditional tale from {d.retoldFrom}.</p>}
    {d.hero && <form class="hero-name" onsubmit="return false">
      <label for="hero">Make your child the hero: type a name and the story changes</label>
      <div><input id="hero" type="text" maxlength="14" placeholder={`e.g. ${d.hero}`} autocomplete="off" /><button type="button" id="hero-reset">Reset</button></div>
      <div class="hero-kind" role="group" aria-label="Hero is a"><button type="button" data-kind="girl" aria-pressed={d.heroIs === 'girl' ? 'true' : 'false'}>Girl</button><button type="button" data-kind="boy" aria-pressed={d.heroIs === 'boy' ? 'true' : 'false'}>Boy</button></div>
    </form>}
    <div class="read-aloud" hidden>
      <button type="button" id="read-btn" class="read-btn" aria-live="polite">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
        <span>Read Story</span>
      </button>
      <button type="button" id="stop-btn" class="stop-btn" hidden>Stop</button>
    </div>
    <div class="story-body prose" data-hero={d.hero} data-hero-is={d.heroIs}><Content /></div>
    <section class="story-lesson">
      <h2>What We Learn From This Story</h2>
      <ul>{d.lesson.map((l) => <li>{l}</li>)}</ul>
    </section>
    <section class="quiz" id="question-time" aria-labelledby="qt-h">
      <h2 id="qt-h">Question Time</h2>
      <p class="quiz-intro">Tap the right answer. You get 1 point for each correct answer!</p>
      <ol class="quiz-list">
        {d.quiz.map((item, qi) => (
          <li class="quiz-q" data-answer={item.answer}>
            <p class="quiz-text">{item.q}</p>
            <div class="quiz-opts">
              {item.options.map((o, oi) => <button type="button" class="quiz-opt" data-i={oi}><span class="quiz-letter">{'ABCD'[oi]}</span>{o}</button>)}
            </div>
            <p class="quiz-feedback" aria-live="polite"></p>
          </li>
        ))}
      </ol>
      <div class="quiz-score" hidden aria-live="polite">
        <p class="quiz-stars"></p>
        <p class="quiz-total"></p>
        <button type="button" class="quiz-again">Try again</button>
      </div>
    </section>
    {(d.words.length > 0 || d.questions.length > 0) && <section class="story-extra">
      {d.words.length > 0 && <>
        <h2>New Words to Learn</h2>
        <dl class="story-words">{d.words.map((w) => <div><dt>{w.word}</dt><dd>{w.meaning}</dd></div>)}</dl>
      </>}
      {d.questions.length > 0 && <>
        <h2>Talk About It Together</h2>
        <ul>{d.questions.map((q) => <li>{q}</li>)}</ul>
      </>}
    </section>}
    <div class="print-story">
      <button type="button" id="print-btn" class="read-btn">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M7 8V3h10v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="3" y="8" width="18" height="9" rx="2" fill="currentColor"/><rect x="7" y="14" width="10" height="7" rx="1" fill="#fff" stroke="currentColor" stroke-width="2"/></svg>
        <span>Print Story</span>
      </button>
      <p>Prints the story with pictures, lessons and questions. Choose "Save as PDF" in the print window to keep a copy.</p>
    </div>
    <Ad />
    {more.length > 0 && <section class="more-stories"><h2>More stories to read</h2><div class="story-grid">
      {more.map((s) => <a class="story-card" href={`/stories/${s.data.slug}/`}><img src={s.data.image} alt={s.data.imageAlt} width="1200" height="800" loading="lazy" /><div class="story-card-body"><h3>{s.data.title.split(':')[0]}</h3></div></a>)}
    </div></section>}
  </article>
  <script is:inline>
  (function () {
    var body = document.querySelector('.story-body'); if (!body) return;
    var hero = body.getAttribute('data-hero'), input = document.getElementById('hero'), title = document.querySelector('.story-title');
    if (!hero || !input) return;
    var nodes = [], walk = function (el) { el.childNodes.forEach(function (n) { if (n.nodeType === 3 && n.nodeValue.indexOf(hero) > -1) nodes.push({ n: n, v: n.nodeValue }); else if (n.nodeType === 1) walk(n); }); };
    walk(body); walk(title); document.querySelectorAll('.story-lesson, .quiz').forEach(walk);
    var re = new RegExp('\\b' + hero + '\\b', 'g');
    function apply(name) {
      name = (name || '').replace(/[^\p{L}\s'.]/gu, '').trim().slice(0, 14);
      name = name ? name.charAt(0).toUpperCase() + name.slice(1) : hero;
      nodes.forEach(function (o) { o.n.nodeValue = o.v.replace(re, name); });
      body.querySelectorAll('img[alt]').forEach(function (img) { if (!img.dataset.alt) img.dataset.alt = img.alt; img.alt = img.dataset.alt.replace(re, name); });
    }
    input.addEventListener('input', function () { apply(input.value); });
    var P = { girl: { subj: 'she', obj: 'her', poss: 'her' }, boy: { subj: 'he', obj: 'him', poss: 'his' } };
    function kind(k) {
      document.querySelectorAll('[data-p]').forEach(function (el) { var w = P[k][el.dataset.p]; if (!w) return; var cap = /^[A-Z]/.test(el.textContent); el.textContent = cap ? w.charAt(0).toUpperCase() + w.slice(1) : w; });
      document.querySelectorAll('.hero-kind button').forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.kind === k ? 'true' : 'false'); });
    }
    document.querySelectorAll('.hero-kind button').forEach(function (b) { b.addEventListener('click', function () { kind(b.dataset.kind); }); });
    document.getElementById('hero-reset').addEventListener('click', function () { input.value = ''; apply(''); kind(body.dataset.heroIs || 'girl'); });
  })();
  (function () {
    var synth = window.speechSynthesis, wrap = document.querySelector('.read-aloud');
    if (!synth || !window.SpeechSynthesisUtterance || !wrap) return;
    wrap.hidden = false;
    var btn = document.getElementById('read-btn'), label = btn.querySelector('span'), stop = document.getElementById('stop-btn');
    var state = 'idle', i = 0, parts = [];
    function collect() {
      // Read the title and the story itself; the activity sits in <section class="story-activity"> and is skipped
      var els = Array.prototype.slice.call(document.querySelectorAll('.story-body > p, .story-body > h2'));
      return [document.querySelector('.story-title')].concat(els);
    }
    function voice() {
      var v = synth.getVoices().filter(function (x) { return /^en(-|_)US/i.test(x.lang); });
      return v.find(function (x) { return /natural|samantha|google us|aria|jenny/i.test(x.name); }) || v[0] || null;
    }
    function mark(el) { document.querySelectorAll('.reading').forEach(function (e) { e.classList.remove('reading'); }); if (el) { el.classList.add('reading'); el.scrollIntoView({ block: 'center', behavior: 'smooth' }); } }
    function set(st) { state = st; label.textContent = st === 'playing' ? 'Pause' : st === 'paused' ? 'Resume' : 'Read Story'; btn.classList.toggle('on', st !== 'idle'); stop.hidden = st === 'idle'; }
    function next() {
      if (state === 'idle') return;
      if (i >= parts.length) { mark(null); set('idle'); return; }
      var el = parts[i++], text = (el.innerText || '').replace(/:.*$/, el.classList.contains('story-title') ? '' : '$&').trim();
      if (!text) return next();
      var u = new SpeechSynthesisUtterance(text); u.rate = 0.9; u.pitch = 1.05; var v = voice(); if (v) u.voice = v; u.lang = 'en-US';
      u.onend = function () { if (state === 'playing') next(); };
      mark(el); synth.speak(u);
    }
    btn.addEventListener('click', function () {
      if (state === 'idle') { synth.cancel(); parts = collect(); i = 0; set('playing'); next(); }
      else if (state === 'playing') { synth.pause(); set('paused'); }
      else { synth.resume(); set('playing'); }
    });
    stop.addEventListener('click', function () { set('idle'); synth.cancel(); mark(null); });
    window.addEventListener('pagehide', function () { synth.cancel(); });
  })();
  (function () { var b = document.getElementById('print-btn'); if (b) b.addEventListener('click', function () { window.print(); }); })();
  (function () {
    var quiz = document.querySelector('.quiz'); if (!quiz) return;
    var qs = Array.prototype.slice.call(quiz.querySelectorAll('.quiz-q')), score = 0, done = 0, ctx;
    function tone(freqs) {
      try { ctx = ctx || new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return; }
      freqs.forEach(function (f, k) { var o = ctx.createOscillator(), g = ctx.createGain(), t = ctx.currentTime + k * 0.12;
        o.type = 'sine'; o.frequency.value = f; g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.18, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.35);
        o.connect(g); g.connect(ctx.destination); o.start(t); o.stop(t + 0.4); });
    }
    var cheers = ['Great job!', 'You got it!', 'Super reader!', 'Well done!', 'Brilliant!'];
    qs.forEach(function (q, qi) {
      var right = +q.dataset.answer, fb = q.querySelector('.quiz-feedback'), btns = q.querySelectorAll('.quiz-opt');
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          if (q.classList.contains('answered')) return;
          q.classList.add('answered'); done++;
          var ok = +b.dataset.i === right;
          btns.forEach(function (x) { x.disabled = true; if (+x.dataset.i === right) x.classList.add('correct'); });
          if (ok) { score++; fb.textContent = '\u2B50 ' + cheers[qi % cheers.length] + ' +1 point'; fb.className = 'quiz-feedback good'; tone([660, 880]); }
          else { b.classList.add('wrong'); fb.textContent = 'Not quite. The right answer is ' + 'ABCD'[right] + '.'; fb.className = 'quiz-feedback bad'; tone([330, 262]); }
          if (done === qs.length) finish();
        });
      });
    });
    function finish() {
      var box = quiz.querySelector('.quiz-score'), n = qs.length;
      box.hidden = false;
      box.querySelector('.quiz-stars').textContent = '\u2B50'.repeat(score) + '\u2606'.repeat(n - score);
      box.querySelector('.quiz-total').textContent = 'You scored ' + score + ' out of ' + n + '! ' + (score === n ? 'Perfect score, story star!' : score >= n - 1 ? 'Amazing reading!' : score >= n / 2 ? 'Good work! Read it again and try for all ' + n + '.' : 'Nice try! Read the story again and have another go.');
      if (score === n) tone([523, 659, 784, 1047]);
      box.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
    quiz.querySelector('.quiz-again').addEventListener('click', function () {
      score = 0; done = 0; quiz.querySelector('.quiz-score').hidden = true;
      qs.forEach(function (q) { q.classList.remove('answered'); q.querySelector('.quiz-feedback').textContent = ''; q.querySelectorAll('.quiz-opt').forEach(function (x) { x.disabled = false; x.classList.remove('correct', 'wrong'); }); });
      quiz.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
  })();
  </script>
</Base>