---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/site';
import { GAMES, GAME_AGES, GAME_SUBJECTS, SUBJECT_NAME } from '../../lib/games';

const AGES = GAME_AGES, SUBJECTS = GAME_SUBJECTS;
// Newest games first: new games are added to the end of GAMES, so show the list reversed.
const LIST = [...GAMES].reverse();

const FAQ = [
  { q: 'Are these learning games for kids really free?',
    a: 'Yes. Every game on this page is free to play in the browser with no account and no download. A paid Parent Premium plan is planned for extras like progress reports, but the free games stay free.' },
  { q: 'What ages are the games made for?',
    a: 'Children aged 3 to 10. Use the age filter to see games for ages 3 to 5, 6 to 8 or 9 to 10. Younger children may need a parent nearby for the first round.' },
  { q: 'Are the games safe for my child?',
    a: 'Children never sign up or type personal details. There is no chat, no links that leave the game, no tracking cookies on game pages and no personalized ads. Only a parent can share an email, and only for the Parent Premium list.' },
  { q: 'Do the games work on phones and tablets?',
    a: 'Yes. They run in any modern browser on a phone, tablet, laptop or classroom board. Buttons are large and made for small fingers, and nothing needs to be installed.' },
  { q: 'How do the matching printable worksheets work?',
    a: 'Each game links to a printable worksheet on the same skill. Play online first, then print the sheet free on Letter or A4 paper so your child can practice away from the screen.' },
];

const jsonld = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'CollectionPage', name: 'Free Learning Games for Kids', url: `${SITE.url}/games/`,
    description: 'Free learning games for kids aged 3 to 10 with matching printable worksheets.',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    audience: { '@type': 'PeopleAudience', suggestedMinAge: 3, suggestedMaxAge: 10 } },
  { '@type': 'ItemList', name: 'Free learning games for kids', itemListElement: LIST.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.name, url: `${SITE.url}/games/${g.slug}/` })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Games', item: `${SITE.url}/games/` } ] },
  { '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
] };
---
<Base
  title="Free Educational Games for Kids | Math, ABC & More"
  description="Free learning games for kids aged 3 to 10: math games, ABC games, times table games and more. Safe, no sign-up, with printable worksheets."
  keywords="free learning games for kids, math games for kids, ABC games, times table games, kids educational games online"
  jsonld={jsonld}
  childSafe
>
  <section class="wrap hero g-hero">
    <p class="crumbs"><a href="/">Home</a> / Games</p>
    <h1>Free Learning Games for Kids</h1>
    <p>Learn math, ABC, telling time and more through play. {GAMES.length} free games for ages 3 to 10 with happy sounds and stars, each with a free printable worksheet to match.</p>
    <div class="g-cta">
      <a class="btn btn-accent g-big" href="#games">Play Now</a>
      <a class="btn btn-dark g-big" href="/category/activities-games/">Get Printable Worksheets</a>
    </div>
  </section>

  <section class="wrap g-filters" aria-labelledby="find-game">
    <h2 id="find-game" class="sr">Find a game by age and subject</h2>
    <div class="g-frow" role="group" aria-label="Filter by age">
      <span class="g-flabel">Age</span>
      <button type="button" class="g-chip on" data-filter="age" data-value="all" aria-pressed="true">All ages</button>
      {AGES.map((a) => <button type="button" class="g-chip" data-filter="age" data-value={a.key} aria-pressed="false">{a.label.replace('Ages ', '')}</button>)}
    </div>
    <div class="g-frow" role="group" aria-label="Filter by subject">
      <span class="g-flabel">Subject</span>
      <button type="button" class="g-chip on" data-filter="subject" data-value="all" aria-pressed="true">All subjects</button>
      {SUBJECTS.map((s) => <button type="button" class="g-chip" data-filter="subject" data-value={s.key} aria-pressed="false">{s.label}</button>)}
    </div>
  </section>

  <section class="wrap section" id="games" aria-labelledby="games-h">
    <div class="sec-head"><h2 id="games-h">Math games, ABC games and more</h2><span class="g-count" aria-live="polite"></span></div>
    <div class="g-grid">
      {LIST.map((g) => (
        <article class="g-card" data-ages={g.ages.join(' ')} data-subjects={g.subjects.join(' ')}>
          <div class="g-thumb">
            <a href={`/games/${g.slug}/`} tabindex="-1" aria-hidden="true"><img src={`/images/games/${g.slug}.svg`} alt={g.alt} width="400" height="300" loading="lazy" decoding="async" /></a>
          </div>
          <div class="g-body">
            <h3><a href={`/games/${g.slug}/`}>{g.name}</a></h3>
            <p>{g.blurb}</p>
            <div class="card-pills">
              <span class="pill">{g.ageLabel}</span>
              {g.subjects.map((s) => <span class="pill pill-teal">{SUBJECT_NAME[s]}</span>)}
            </div>
            <a class="g-play" href={`/games/${g.slug}/`} aria-label={`Play ${g.name}`}>Play</a>
            <a class="g-sheet" href={g.sheet}>Matching worksheet: {g.sheetName}</a>
          </div>
        </article>
      ))}
    </div>
    <p class="g-empty" hidden>No games match these filters yet. Hindi and Marathi games are on the way. Try another age or subject.</p>
    <p class="g-privacy">Game pages use no tracking cookies and show no personalized ads, and we never collect data from children. See our <a href="/privacy-policy/">privacy policy</a>.</p>
  </section>

  <section class="wrap section" aria-labelledby="print-h">
    <div class="g-band">
      <div>
        <h2 id="print-h">Play the game, then print the worksheet</h2>
        <p>Every game has a matching printable worksheet pack on the same skill. Play a round on screen, then sit down with paper and crayons to practice it again. Kids remember more when they meet an idea twice, and parents get a quiet screen-free activity.</p>
        <p>Start with a few favorites: the <a href="/mitten-matching-game/">mitten matching game</a>, the <a href="/turkey-color-by-number/">turkey color by number</a> or the <a href="/thanksgiving-word-search/">Thanksgiving word search</a>.</p>
      </div>
      <a class="btn btn-accent g-big" href="/category/activities-games/">Browse printable worksheets</a>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="premium-h">
    <div class="g-premium">
      <div>
        <span class="season">For parents</span>
        <h2 id="premium-h">Parent Premium is coming</h2>
        <ul class="g-list">
          <li><strong>Ad-free</strong> play on every game</li>
          <li><strong>All levels</strong> unlocked, from first steps to challenge mode</li>
          <li><strong>Progress reports</strong> for parents, never shown to kids</li>
        </ul>
      </div>
      <form class="g-form" action="/notify.php" method="post" novalidate>
        <label for="notify-email" class="g-flabel">Parent email</label>
        <input id="notify-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="parent@example.com" required />
        <input class="sr" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="g-check"><input type="checkbox" name="adult" value="yes" required /> I am a parent, guardian or teacher aged 18 or over</label>
        <button type="submit" class="btn btn-dark g-big">Coming Soon / Notify Me</button>
        <p class="g-small">We use this email only to tell you once when Parent Premium opens. Kids should not fill in this form. <a href="/privacy-policy/">Privacy policy</a></p>
        <p class="g-msg" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="safe-h">
    <h2 id="safe-h" class="g-h2">Kids educational games online, built safe</h2>
    <div class="trust g-trust">
      <div><strong>Safe for kids</strong><span>Calm colors, no scary content and no famous characters.</span></div>
      <div><strong>No sign-up for children</strong><span>Kids just tap Play. No names, emails or logins.</span></div>
      <div><strong>No chat</strong><span>There is no way to message or meet other players.</span></div>
      <div><strong>No external links in games</strong><span>Games never send your child to another website.</span></div>
    </div>
  </section>

  <section class="wrap gp-left" aria-labelledby="faq-h"><div class="faq g-faq">
    <h2 id="faq-h">Questions parents and teachers ask</h2>
    {FAQ.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </div></section>

  <script is:inline>
    (function () {
      var state = { age: 'all', subject: 'all' };
      var cards = document.querySelectorAll('.g-card'), empty = document.querySelector('.g-empty'), count = document.querySelector('.g-count');
      function apply() {
        var n = 0;
        cards.forEach(function (c) {
          var ok = (state.age === 'all' || c.dataset.ages.split(' ').indexOf(state.age) > -1) &&
                   (state.subject === 'all' || c.dataset.subjects.split(' ').indexOf(state.subject) > -1);
          c.hidden = !ok; if (ok) n++;
        });
        empty.hidden = n > 0;
        count.textContent = n + (n === 1 ? ' game' : ' games');
      }
      document.querySelectorAll('.g-chip').forEach(function (b) {
        b.addEventListener('click', function () {
          var f = b.dataset.filter; state[f] = b.dataset.value;
          document.querySelectorAll('.g-chip[data-filter="' + f + '"]').forEach(function (x) {
            var on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
          apply();
        });
      });
      apply();

      var form = document.querySelector('.g-form'), msg = form.querySelector('.g-msg');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = form.email.value.trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.textContent = 'Please enter a valid email address.'; return; }
        if (!form.adult.checked) { msg.textContent = 'Please confirm you are a parent, guardian or teacher aged 18 or over.'; return; }
        msg.textContent = 'Sending...';
        fetch(form.action, { method: 'POST', body: new FormData(form) })
          .then(function (r) { return r.json(); })
          .then(function (d) { msg.textContent = d.message; if (d.ok) form.reset(); })
          .catch(function () { msg.textContent = 'Sorry, that did not go through. Please try again later.'; });
      });
    })();
  </script>
</Base>

<style>
  .g-hero { padding-bottom: 28px; }
  .g-hero .crumbs { margin: 0; }
  .g-cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 4px; }
  .g-big { min-height: 52px; padding: 15px 28px; font-size: 17px; }
  .g-filters { display: flex; flex-direction: column; gap: 12px; padding-bottom: 20px; }
  .g-frow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .g-flabel { font-weight: 800; font-size: 15px; min-width: 70px; }
  .g-chip { font: inherit; font-weight: 700; font-size: 15px; min-height: 44px; padding: 8px 16px; border: 2px solid var(--line2); border-radius: 24px; background: var(--white); color: var(--ink); cursor: pointer; }
  .g-chip:hover { border-color: var(--accent); }
  .g-chip.on { background: var(--accent); border-color: var(--accent); color: var(--white); }
  .g-chip:focus-visible, .g-play:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .g-count { font-weight: 800; color: var(--soft); white-space: nowrap; }
  .g-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 22px; }
  .g-card { background: var(--white); border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 4px 14px rgba(60,40,20,.05); }
  .g-card[hidden] { display: none; }
  .g-thumb { position: relative; aspect-ratio: 4 / 3; }
  .g-thumb img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .g-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .g-body h3 { margin: 0; font-size: 22px; font-weight: 600; }
  .g-body p { margin: 0; color: var(--muted); }
  .g-play { margin-top: auto; display: flex; align-items: center; justify-content: center; text-decoration: none; font: inherit; font-weight: 800; font-size: 18px; min-height: 52px; border: 0; border-radius: 28px; background: var(--accent); color: var(--white); cursor: pointer; }
  .g-play:hover { color: var(--white); filter: brightness(1.08); }
  .g-body h3 a { color: var(--ink); text-decoration: none; }
  .g-body h3 a:hover { color: var(--accent-dark); }
  .g-sheet { font-weight: 700; font-size: 14px; text-align: center; }
  .g-empty { text-align: center; font-weight: 700; color: var(--muted); padding: 24px 0; }
  .g-privacy { margin: 20px 0 0; font-size: 14px; color: var(--soft); text-align: center; }
  .g-band { background: var(--teal-bg); border-radius: 24px; padding: 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .g-band > div { flex: 1 1 420px; }
  .g-band h2, .g-premium h2 { margin: 0 0 8px; font-size: 26px; }
  .g-band p { margin: 0 0 10px; }
  .g-premium { background: var(--white); border: 1px solid var(--line); border-radius: 24px; padding: 28px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; align-items: center; }
  .g-premium h2 { margin-top: 12px; }
  .g-list { margin: 0; padding-left: 20px; }
  .g-list li { margin-bottom: 6px; }
  .g-form { display: flex; flex-direction: column; gap: 10px; }
  .g-form input[type=email] { font: inherit; font-size: 17px; padding: 14px 18px; border: 2px solid var(--line2); border-radius: 30px; background: var(--white); min-height: 52px; }
  .g-check { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; font-weight: 600; cursor: pointer; }
  .g-check input { width: 22px; height: 22px; margin: 1px 0 0; flex: none; accent-color: var(--accent); }
  .g-small { margin: 0; font-size: 13px; color: var(--soft); }
  .g-msg { margin: 0; font-weight: 700; color: var(--green); min-height: 1.2em; }
  .g-h2 { font-size: 28px; margin: 0 0 16px; }
  .g-trust { padding-bottom: 0; }
  .g-trust > div { background: var(--white); border: 1px solid var(--line); border-radius: 20px; padding: 18px; }
  .g-faq { padding-bottom: 32px; }
  .gp-left .faq { margin-left: 0; }
  @media (max-width: 600px) {
    .g-cta { flex-direction: column; width: 100%; max-width: 360px; }
    .g-cta .btn { text-align: center; }
    .g-flabel { width: 100%; }
    .g-band, .g-premium { padding: 22px; }
  }
</style>
