---
const { page, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}${n}/`);
---
{page.lastPage > 1 && (
  <nav class="pager" aria-label="Pages">
    {page.currentPage > 1 && <a href={href(page.currentPage - 1)}>← Newer</a>}
    <span>Page {page.currentPage} of {page.lastPage}</span>
    {page.currentPage < page.lastPage && <a href={href(page.currentPage + 1)}>Older →</a>}
  </nav>
)}
