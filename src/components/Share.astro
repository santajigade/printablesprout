---
import { SITE } from '../lib/site';
const { slug, title, image } = Astro.props;
const url = `${SITE.url}/${slug}/`;
const img = image ? `${SITE.url}${image}` : `${SITE.url}/images/${slug}.png`;
const e = encodeURIComponent;
const links = [
  { k: 'pinterest', label: 'Save to Pinterest', href: `https://www.pinterest.com/pin/create/button/?url=${e(url)}&media=${e(img)}&description=${e(title)}` },
  { k: 'facebook', label: 'Share on Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${e(url)}` },
  { k: 'whatsapp', label: 'Share on WhatsApp', href: `https://wa.me/?text=${e(title + ' ' + url)}` },
  { k: 'x', label: 'Share on X', href: `https://x.com/intent/post?url=${e(url)}&text=${e(title)}` },
  { k: 'email', label: 'Share by email', href: `mailto:?subject=${e(title)}&body=${e('Free printable: ' + url)}` },
];
const icons: Record<string, string> = {
  pinterest: '<circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M12.4 6.5c-3.2 0-5 2.2-5 4.4 0 1.1.5 2.2 1.4 2.6.2.1.3 0 .3-.2l.2-.9c0-.1 0-.2-.1-.3-.3-.4-.5-.9-.5-1.5 0-1.9 1.4-3.5 3.6-3.5 2 0 3 1.2 3 2.8 0 2.1-.9 3.8-2.3 3.8-.7 0-1.3-.6-1.1-1.4.2-.9.6-1.9.6-2.6 0-.6-.3-1.1-1-1.1-.8 0-1.4.8-1.4 1.9 0 .7.2 1.1.2 1.1l-1 4.2c-.2.9-.1 2.1 0 2.7l.4-.1c.3-.5 1-1.6 1.2-2.4l.4-1.6c.3.5 1 .9 1.8.9 2.3 0 3.9-2.1 3.9-5 0-2.4-2-4.4-4.6-4.4z" fill="#fff"/>',
  facebook: '<circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M13.2 21.9v-7.1h2.3l.4-2.8h-2.7v-1.7c0-.8.3-1.4 1.4-1.4h1.4V6.4c-.3 0-1.1-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.6V12H8.1v2.8h2.3v7.1" fill="#fff"/>',
  whatsapp: '<path d="M12 2.5a9.5 9.5 0 0 0-8.2 14.3L2.5 21.5l4.8-1.3A9.5 9.5 0 1 0 12 2.5z" fill="currentColor"/><path d="M9 7.6c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.9 4.5 4 2.2.9 2.7.7 3.2.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3l-1.7-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2-1.2-.7-.7-1.2-1.5-1.4-1.7-.1-.3 0-.4.1-.5l.4-.5.3-.4v-.5L9 7.6z" fill="#fff"/>',
  x: '<circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M7.2 7h3.1l2.3 3.2L15.4 7h1.3l-3.5 4 3.9 6h-3.1l-2.5-3.6L8.4 17H7.1l3.8-4.4z" fill="#fff"/>',
  email: '<circle cx="12" cy="12" r="10" fill="currentColor"/><rect x="6.5" y="8" width="11" height="8" rx="1" fill="none" stroke="#fff" stroke-width="1.5"/><path d="M6.8 8.4 12 12.6l5.2-4.2" fill="none" stroke="#fff" stroke-width="1.5"/>',
  copy: '<circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M10.6 13.4a3 3 0 0 0 4.2 0l2-2a3 3 0 0 0-4.2-4.2l-.7.7M13.4 10.6a3 3 0 0 0-4.2 0l-2 2a3 3 0 0 0 4.2 4.2l.7-.7" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>',
};
---
<div class="share" aria-label="Share this printable">
  <span class="share-l">Share</span>
  {links.map((l) => (
    <a class={`sh sh-${l.k}`} href={l.href} target="_blank" rel="noopener nofollow" aria-label={l.label} title={l.label}>
      <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true" set:html={icons[l.k]} />
    </a>
  ))}
  <button type="button" class="sh sh-copy" data-copy={url} aria-label="Copy link" title="Copy link">
    <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true" set:html={icons.copy} />
  </button>
  <span class="share-ok" role="status"></span>
</div>
<script is:inline>
document.querySelectorAll('.sh-copy').forEach(function (b) {
  b.addEventListener('click', function () {
    var u = b.getAttribute('data-copy'), ok = b.parentNode.querySelector('.share-ok');
    function done() { ok.textContent = 'Link copied'; setTimeout(function () { ok.textContent = ''; }, 2000); }
    if (navigator.share && matchMedia('(pointer:coarse)').matches) { navigator.share({ url: u, title: document.title }).catch(function () {}); return; }
    if (navigator.clipboard) navigator.clipboard.writeText(u).then(done, function () { prompt('Copy this link', u); });
    else prompt('Copy this link', u);
  });
});
</script>
