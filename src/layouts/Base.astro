---
import { SITE, NAV, CATEGORIES, OCCASIONS, catBySlug } from '../lib/site';
import '../styles/global.css';
interface Props {
  title: string; description: string; image?: string; imageAlt?: string; type?: string; jsonld?: object; noindex?: boolean;
  publishedTime?: Date; modifiedTime?: Date; keywords?: string;
}
const { title, description, image, imageAlt, type = 'website', jsonld, noindex, publishedTime, modifiedTime, keywords } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image ?? '/og-default.png', SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt ?? title} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#c2541b" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  {SITE.ga4Id && <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>}
  {SITE.ga4Id && <script is:inline define:vars={{ ga4Id: SITE.ga4Id }}>
    window.dataLayer = window.dataLayer || []; window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date()); gtag('config', ga4Id);
  </script>}
  {SITE.adsenseClient && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>}
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="logo" aria-label="PrintableSprout home">Printable<span>Sprout</span></a>
      <nav class="main-nav" aria-label="Main">
        {NAV.map((n) => (n.children || n.occasions) ? (
          <div class="nav-group">
            <a href={n.href}>{n.label} <span aria-hidden="true">▾</span></a>
            <div class="nav-drop">
              {n.children && n.children.map((s) => { const c = catBySlug(s)!; return <a href={`/category/${c.slug}/`}>{c.name}</a>; })}
              {n.occasions && OCCASIONS.map((o) => <a href={`/holiday/${o.slug}/`}>{o.name}</a>)}
            </div>
          </div>
        ) : <a href={n.href}>{n.label}</a>)}
      </nav>
      <div style="display:flex;gap:8px">
        <a href="/search/" class="icon-btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
        <button class="icon-btn menu-btn" type="button" aria-label="Menu" onclick="document.body.classList.toggle('nav-open')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <span class="logo" style="color:#fff">PrintableSprout</span>
        <p>Original printables for parents and teachers. Color online or print free on Letter and A4.</p>
      </div>
      <div><h4>Printables</h4>{CATEGORIES.map((c) => <a href={`/category/${c.slug}/`}>{c.name}</a>)}</div>
      <div><h4>Holidays</h4>{OCCASIONS.slice(0, 6).map((o) => <a href={`/holiday/${o.slug}/`}>{o.name}</a>)}</div>
      <div><h4>About</h4><a href="/about/">About Us</a><a href="/author/santaji-gadepatil/">Our Designer</a><a href="/editorial-policy/">Editorial Policy</a><a href="/corrections-policy/">Corrections Policy</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-of-use/">Terms of Use</a><a href="/disclaimer/">Disclaimer</a></div>
    </div>
    <div class="wrap copyright">© {year} {SITE.name}. Free for personal and classroom use.</div>
  </footer>
</body>
</html>
