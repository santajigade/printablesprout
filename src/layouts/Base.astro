---
import { SITE, SOCIAL, NAV, CATEGORIES, OCCASIONS, catBySlug } from '../lib/site';
import '../styles/global.css';
interface Props {
  title: string; description: string; image?: string; imageAlt?: string; type?: string; jsonld?: object; noindex?: boolean;
  publishedTime?: Date; modifiedTime?: Date; keywords?: string;
  /** Child-directed page: no analytics, no ads, no tracking cookies */
  childSafe?: boolean;
}
const { title, description, image, imageAlt, type = 'website', jsonld, noindex, publishedTime, modifiedTime, keywords, childSafe } = Astro.props;
const analytics = !childSafe && SITE.ga4Id;
const ads = !childSafe && SITE.adsenseClient;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image ?? '/og-default.png', SITE.url).href + '?v=3'; // bump v when share images change so apps refetch
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : title.startsWith(SITE.name) ? title : `${title} | ${SITE.name}`;
const year = new Date().getFullYear();
const SOCIAL_ICONS: Record<string, string> = {"pinterest": '<circle cx="12" cy="12" r="10" fill="#e60023"/><path d="M12.4 6.5c-3.2 0-5 2.2-5 4.4 0 1.1.5 2.2 1.4 2.6.2.1.3 0 .3-.2l.2-.9c0-.1 0-.2-.1-.3-.3-.4-.5-.9-.5-1.5 0-1.9 1.4-3.5 3.6-3.5 2 0 3 1.2 3 2.8 0 2.1-.9 3.8-2.3 3.8-.7 0-1.3-.6-1.1-1.4.2-.9.6-1.9.6-2.6 0-.6-.3-1.1-1-1.1-.8 0-1.4.8-1.4 1.9 0 .7.2 1.1.2 1.1l-1 4.2c-.2.9-.1 2.1 0 2.7l.4-.1c.3-.5 1-1.6 1.2-2.4l.4-1.6c.3.5 1 .9 1.8.9 2.3 0 3.9-2.1 3.9-5 0-2.4-2-4.4-4.6-4.4z" fill="#fff"/>', "facebook": '<circle cx="12" cy="12" r="10" fill="#1877f2"/><path d="M13.2 21.9v-7.1h2.3l.4-2.8h-2.7v-1.7c0-.8.3-1.4 1.4-1.4h1.4V6.4c-.3 0-1.1-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.6V12H8.1v2.8h2.3v7.1" fill="#fff"/>', "instagram": '<circle cx="12" cy="12" r="10" fill="#d62976"/><rect x="7" y="7" width="10" height="10" rx="3" fill="none" stroke="#fff" stroke-width="1.6"/><circle cx="12" cy="12" r="2.4" fill="none" stroke="#fff" stroke-width="1.6"/><circle cx="15" cy="9" r=".8" fill="#fff"/>', "linkedin": '<circle cx="12" cy="12" r="10" fill="#0a66c2"/><rect x="7.4" y="10" width="2" height="6.6" fill="#fff"/><circle cx="8.4" cy="7.9" r="1.2" fill="#fff"/><path d="M11.2 10h1.9v.9c.3-.6 1.1-1.1 2.2-1.1 2 0 2.4 1.3 2.4 3v3.8h-2v-3.4c0-.8 0-1.8-1.1-1.8s-1.3.9-1.3 1.8v3.4h-2.1z" fill="#fff"/>'};
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#c2541b" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt ?? title} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="p:domain_verify" content="28f8bbc86560af7926c4d56c63c67beb" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  {analytics && <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>}
  {analytics && <script is:inline define:vars={{ ga4Id: SITE.ga4Id }}>
    window.dataLayer = window.dataLayer || []; window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date()); gtag('config', ga4Id);
  </script>}
  {ads && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>}
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="logo" aria-label="PrintableSprout home"><svg class="logo-mark" viewBox="0 0 120 120" aria-hidden="true"><rect width="120" height="120" rx="32" fill="#c2541b"/><g transform="translate(60,100) scale(1.05)"><path d="M0 0 C 0 -12 0 -20 0 -26" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round"/><path d="M0 -24 C -6 -44 -26 -52 -44 -48 C -40 -30 -22 -20 0 -24 Z" fill="#fff"/><path d="M0 -26 C 6 -50 28 -60 48 -54 C 42 -34 22 -22 0 -26 Z" fill="#ffe1c7"/></g></svg><span class="logo-text">Printable<span>Sprout</span></span></a>
      <nav class="main-nav" id="main-nav" aria-label="Main">
        {NAV.map((n) => (n.children || n.occasions) ? (
          <div class="nav-group">
            <a href={n.href}>{n.label} <span aria-hidden="true">▾</span></a>
            <div class="nav-drop">
              {n.children && n.children.map((s) => { const c = catBySlug(s)!; return <a href={`/category/${c.slug}/`}>{c.name}</a>; })}
              {n.occasions && OCCASIONS.map((o) => <a href={`/holiday/${o.slug}/`}>{o.name}</a>)}
            </div>
          </div>
        ) : <a href={n.href}>{n.label}</a>)}
      </nav>
      <div style="display:flex;gap:8px">
        <a href="/search/" class="icon-btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
        <button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="main-nav">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
  </header>
  <script is:inline>
    (function () {
      var h = document.querySelector('.site-header'), b = document.body, btn = h.querySelector('.menu-btn'), root = document.documentElement;
      function size() { root.style.setProperty('--hh', h.offsetHeight + 'px'); }
      function shade() { h.classList.toggle('scrolled', window.scrollY > 4); }
      function setOpen(open) { b.classList.toggle('nav-open', open); btn.setAttribute('aria-expanded', open ? 'true' : 'false'); }
      size(); shade();
      window.addEventListener('scroll', shade, { passive: true });
      window.addEventListener('resize', function () { size(); if (window.innerWidth > 1020) setOpen(false); });
      if (document.fonts) document.fonts.ready.then(size);
      btn.addEventListener('click', function () { setOpen(!b.classList.contains('nav-open')); });
      h.querySelector('.main-nav').addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
    })();
  </script>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <span class="logo" style="color:#fff">PrintableSprout</span>
        <p>Original printables for parents and teachers. Color online or print free on Letter and A4.</p>
        <div class="social">
          {SOCIAL.map((s) => (
            <a href={s.url} target="_blank" rel="noopener me" aria-label={`PrintableSprout on ${s.name}`} title={s.name}>
              <svg viewBox="0 0 24 24" width="36" height="36" aria-hidden="true" set:html={SOCIAL_ICONS[s.key]} />
            </a>
          ))}
        </div>
      </div>
      <div><h4>Printables</h4>{CATEGORIES.map((c) => <a href={`/category/${c.slug}/`}>{c.name}</a>)}</div>
      <div><h4>Holidays</h4>{OCCASIONS.slice(0, 6).map((o) => <a href={`/holiday/${o.slug}/`}>{o.name}</a>)}</div>
      <div><h4>About</h4><a href="/about/">About Us</a><a href="/author/santaji-gadepatil/">Our Designer</a><a href="/editorial-policy/">Editorial Policy</a><a href="/corrections-policy/">Corrections Policy</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-of-use/">Terms of Use</a><a href="/disclaimer/">Disclaimer</a></div>
    </div>
    <div class="wrap copyright">© {year} {SITE.name}. Free for personal and classroom use.</div>
  </footer>
</body>
</html>
